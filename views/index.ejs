<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Prompt Submission</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
  </head>
  <body class="bg-gray-100">
    <div class="flex justify-center min-h-screen p-4 items-center">
      <div class="w-full lg:max-w-2xl bg-white rounded-lg shadow-lg p-6">
        <h1 class="text-2xl font-semibold mb-4 text-center text-gray-700">
          Submit a Prompt
        </h1>
        <form
          id="promptForm"
          action="/submit-prompt"
          method="POST"
          class="space-y-4"
        >
          <textarea
            name="prompt"
            rows="6"
            cols="50"
            placeholder="Enter your prompt here..."
            class="w-full border border-gray-300 p-3 rounded-lg focus:outline-none focus:border-blue-500"
            required
          ></textarea>

          <button
            type="submit"
            class="w-full bg-blue-500 text-white font-semibold py-2 rounded-lg hover:bg-blue-600 transition duration-200 ease-in-out"
          >
            Submit
          </button>
          <!-- Loading spinner -->
          <div id="loadingIndicator" class="hidden flex justify-center mt-4">
            <div
              class="loader ease-linear rounded-full border-4 border-t-4 border-gray-200 h-6 w-6"
            ></div>
          </div>
        </form>

        <!-- Response Section -->
        <% if (typeof response !== 'undefined') { %>
        <div class="mt-6 p-4 bg-green-100 rounded-lg">
          <div class="flex justify-between mb-4 items-center">
            <h2 class="text-lg font-semibold text-green-700">
              Response Preview:
            </h2>
            <div class="flex space-x-2">
              <button class="text-blue-500 hover:text-blue-700" id="copyButton">
                Copy
              </button>
              <button class="text-red-500 hover:text-red-700" id="clearButton">
                Clear
              </button>
            </div>
          </div>
          <div
            id="markdownPreview"
            class="prose prose-sm max-w-none whitespace-pre-wrap"
          >
            <!-- Render raw markdown content here -->
            <!-- We encode the raw response here for JS to parse and display -->
            <span id="rawResponse" class="hidden"><%- response %></span>
          </div>
        </div>

        <script>
          // Fetch raw response content (markdown text)
          const rawResponse = document
            .getElementById("rawResponse")
            .innerText.trim();

          // Convert raw markdown text to HTML using marked.js
          const parsedMarkdown = marked.parse(rawResponse);

          // Render the parsed markdown as HTML in the preview
          document.getElementById("markdownPreview").innerHTML = parsedMarkdown;
        </script>
        <% } %>
      </div>
    </div>

    <style>
      .loader {
        border-top-color: #3498db;
        animation: spin 1s infinite linear;
      }
      @keyframes spin {
        0% {
          transform: rotate(0deg);
        }
        100% {
          transform: rotate(360deg);
        }
      }
    </style>

    <script>
      const form = document.getElementById("promptForm");
      const loadingIndicator = document.getElementById("loadingIndicator");

      form.addEventListener("submit", function () {
        // Show loading spinner when form is submitted
        loadingIndicator.classList.remove("hidden");
      });

      const copyButton = document.getElementById("copyButton");

      copyButton.addEventListener("click", function () {
        const markdownPreview = document.getElementById("markdownPreview");
        const markdownText = markdownPreview.innerHTML;

        navigator.clipboard.writeText(markdownText);

        copyButton.textContent = "Copied!";
        setTimeout(function () {
          copyButton.textContent = "Copy";
        }, 2000);
      });

      const clearButton = document.getElementById("clearButton");

      clearButton.addEventListener("click", function () {
        const markdownPreview = document.getElementById("markdownPreview");
        markdownPreview.innerHTML = "";

        copyButton.textContent = "Copy";
      });
    </script>
  </body>
</html>
